          "select": {
            "source_id": "@item()?['id']",
            "name": "@item()?['name']",
            "status": "@if(and(lessOrEquals(length(outputs('Get_email')?['body/attachments']), 5), endsWith(toLower(coalesce(item()?['name'], '')), '.txt'), or(startsWith(toLower(coalesce(item()?['contentType'], '')), 'text/plain'), equals(toLower(coalesce(item()?['contentType'], '')), 'application/octet-stream')), lessOrEquals(coalesce(item()?['size'], 65537), 65536), not(empty(item()?['contentBytes'])), not(equals(item()?['isInline'], true))), 'ok', 'unsupported_input')",
            "text": "@if(and(lessOrEquals(length(outputs('Get_email')?['body/attachments']), 5), endsWith(toLower(coalesce(item()?['name'], '')), '.txt'), or(startsWith(toLower(coalesce(item()?['contentType'], '')), 'text/plain'), equals(toLower(coalesce(item()?['contentType'], '')), 'application/octet-stream')), lessOrEquals(coalesce(item()?['size'], 65537), 65536), not(empty(item()?['contentBytes'])), not(equals(item()?['isInline'], true))), base64ToString(item()?['contentBytes']), '')"
