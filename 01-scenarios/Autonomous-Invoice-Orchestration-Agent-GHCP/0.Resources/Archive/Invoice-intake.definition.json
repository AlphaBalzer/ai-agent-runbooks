                "organization": "__DATAVERSE_ORGANIZATION_URL__",
                "entityName": "cr090_ghcpinvoicereviews",
                "$select": "cr090_ghcpinvoicereviewid,cr090_intakekey,cr090_reviewstate,cr090_sourcefileurl,cr090_reviewpayload,versionnumber",
                "$filter": "@concat('cr090_intakekey eq ''ghcp-invoice|',replace(triggerBody()?['text'],'''',''''''),'''')",
