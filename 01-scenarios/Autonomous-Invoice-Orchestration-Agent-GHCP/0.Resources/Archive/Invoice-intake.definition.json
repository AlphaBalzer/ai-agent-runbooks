                "error_code": "@concat('claim=',coalesce(actions('Claim_intake')?['status'],'not_run'),';file=',coalesce(actions('Save_source')?['status'],'not_run'),';record=',coalesce(actions('Record_saved_source')?['status'],'not_run'),';reconcile=',coalesce(actions('Reconcile_intake')?['status'],'not_run'))",
                "record_state": "@coalesce(if(equals(length(coalesce(outputs('Reconcile_intake')?['body/value'],json('[]'))),1),first(coalesce(outputs('Reconcile_intake')?['body/value'],json('[]')))?['cr090_reviewstate'],null),if(equals(actions('Claim_intake')?['status'],'Succeeded'),'intake_claimed','unknown'),'unknown')",
                "reconciliation": "@if(equals(actions('Reconcile_intake')?['status'],'Succeeded'),if(equals(length(coalesce(outputs('Reconcile_intake')?['body/value'],json('[]'))),1),'confirmed','not_reconciled'),'unavailable')"
              }
            },
            "runAfter": {
              "Reconcile_intake": [
                "Succeeded",
                "Failed",
                "TimedOut",
                "Skipped"
              ]
            }
          },
          "Set_intake_result": {
            "type": "SetVariable",
            "inputs": {
              "name": "intake_result",
              "value": "@first(body('Intake_outcome'))"
            },
            "runAfter": {
              "Intake_outcome": [
                "Succeeded"
              ]
            }
          }
        },
        "else": {
          "actions": {}
        },
        "runAfter": {
          "Select": [
            "Succeeded"
