            "inputs": {
              "from": "@json('[{}]')",
              "select": {
                "record_id": "@coalesce(outputs('Claim_intake')?['body/cr090_ghcpinvoicereviewid'],if(equals(length(coalesce(outputs('Reconcile_intake')?['body/value'],json('[]'))),1),first(coalesce(outputs('Reconcile_intake')?['body/value'],json('[]')))?['cr090_ghcpinvoicereviewid'],''),'')",
